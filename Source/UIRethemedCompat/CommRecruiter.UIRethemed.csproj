<Project Sdk="Microsoft.NET.Sdk">
	<!-- The hire window drawn with [LFS] UI Rethemed - Core. Compiled against its DLL and loaded only when that mod is
	     active (LoadFolders.xml IfModActive), so Comm Recruiter never depends on it. Building this also builds
	     CommRecruiter.csproj. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>CommRecruiter.UIRethemed</RootNamespace>
		<AssemblyName>CommRecruiter.UIRethemed</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<OutputPath>..\..\Compat\UIRethemed\1.7\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<RimWorldDir>$(MSBuildThisFileDirectory)..\..\..\..</RimWorldDir>
		<!-- [LFS] UI Rethemed - Core, Steam Workshop 3832843406. Override with -p:LfsCoreDir=... for a local copy. -->
		<LfsCoreDir Condition="'$(LfsCoreDir)' == ''">$(RimWorldDir)\..\..\workshop\content\294100\3832843406\</LfsCoreDir>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="obj/**" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\CommRecruiter.csproj" Private="false" />
		<Reference Include="UIRethemedCore">
			<HintPath>$(LfsCoreDir)Versions\1.7\Assemblies\UIRethemedCore.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
